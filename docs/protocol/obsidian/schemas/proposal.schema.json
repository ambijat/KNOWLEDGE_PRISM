{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://knowledge-prism.local/schemas/proposal.schema.json",
  "title": "Knowledge Prism Proposal (inbound from Obsidian)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_version",
    "record_id",
    "proposal_type",
    "status",
    "rationale",
    "created_by",
    "created_ts"
  ],
  "properties": {
    "proposal_version": { "const": "1.0" },
    "record_id": { "type": "string", "pattern": "^PROP-[0-9]{6}$" },
    "proposal_type": {
      "type": "string",
      "enum": [
        "relationship_proposal",
        "correction_proposal",
        "research_question",
        "synthesis_candidate"
      ]
    },
    "status": {
      "description": "A proposal MUST declare itself proposed and nothing else.",
      "const": "proposed"
    },
    "title": { "type": "string" },
    "rationale": { "type": "string", "minLength": 1 },
    "created_by": { "type": "string", "minLength": 1 },
    "created_ts": { "type": "string" },
    "source_id": {
      "type": "string",
      "pattern": "^(SRC|PAS|CON|ENT|CLM|REL|PROP)-[0-9]{6}$"
    },
    "target_id": {
      "type": "string",
      "pattern": "^(SRC|PAS|CON|ENT|CLM|REL|PROP)-[0-9]{6}$"
    },
    "predicate": {
      "type": "string",
      "enum": [
        "supports", "contradicts", "defines", "mentions", "causes",
        "enables", "constrains", "located_in", "part_of", "instrument_of",
        "associated_with", "precedes", "responds_to", "fuses_with"
      ]
    },
    "body": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "proposal_type": { "const": "relationship_proposal" } } },
      "then": { "required": ["source_id", "target_id", "predicate"] }
    }
  ]
}
